# Railway uses this instead of .gitignore when present.
#
# The important difference: the trained model IS uploaded here, because it is
# required at runtime but excluded from git for size reasons. Without it the
# classifier silently scores every URL as 0.

# The frontend is deployed separately on Vercel
frontend/

# Local environment
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.git/
_git_scaffold_backup/

# Training data - only needed to retrain, never at runtime (79 MB)
data/PhiUSIIL_Phishing_URL_Dataset.csv
data/urls.csv
data/*.zip
data/evaluation/*.zip

# Full Tranco list - the trimmed top-10k file is used instead (22 MB)
data/evaluation/top-1m.csv

# Runtime database, recreated on start
scans.db

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
